APP_NAME="Academic Compliance & Violation Management System"
APP_URL=http://localhost
APP_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

UPLOAD_PATH=uploads/evidence/

SESSION_NAME=acvms_session
SESSION_LIFETIME=120

# AI Integration — Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Configuration (Gmail)
# IMPORTANT: Use a generated Google App Password, not your real account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password_here
